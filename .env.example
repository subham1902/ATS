# ATS environment variable template.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# All variables below are optional at runtime depending on which integrations are active.

# --- Upstox (market data / derivatives acquisition) ---
ATS_UPSTOX_ACCESS_TOKEN=
ATS_UPSTOX_CLIENT_ID=
ATS_UPSTOX_CLIENT_SECRET=

# --- Inference providers (harness / advisory sidecars) ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
