# XAUUSD only. Keep real credentials local; never commit .env.
# Read-only standalone market session; account UI uses the encrypted DPAPI vault.
ATS_METATRADER_VERSION=MT5
ATS_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
ATS_MT5_SYMBOL=XAUUSD
ATS_MT5_LOGIN=
ATS_MT5_PASSWORD=
ATS_MT5_SERVER=
# Research can run without a terminal. Account connections are operator initiated.
ATS_OFFLINE_RESEARCH=1
ATS_DATA_ROOT=data
# Step 1 retains internal paper execution. External authority arrives in Step 3.
LIVE_MONEY=FALSE
ATS_EXECUTION_DESTINATION=PaperBroker
# Optional read-only MT4 quote bridge, not an authenticated account transport.
ATS_MT4_SNAPSHOT_PATH=
ATS_MT4_SYMBOL=XAUUSD
# Agent inference credential references are separate from account credentials.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
